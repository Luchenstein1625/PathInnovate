# Copia a .env (esta en .gitignore). NUNCA metas .env en un zip ni en un commit.
# Sin comentarios en la misma linea que el valor.
MAGISTER_ROOT=
# Cadena con respaldo: prueba ChatGPT y, si falla, Hugging Face. Opciones: openai | huggingface | hf_local | anthropic
LLM_PROVIDER=openai,huggingface
LLM_MODEL_OPENAI=
LLM_MODEL_HUGGINGFACE=Qwen/Qwen3.5-4B
# LLM_MODEL_HF_LOCAL=Qwen/Qwen2.5-1.5B-Instruct
OPENAI_API_KEY=
HF_TOKEN=
ANTHROPIC_API_KEY=
